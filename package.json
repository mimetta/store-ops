{
  "name": "store-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:permissions": "node scripts/check-permission-drift.mjs",
    "uat:sql": "node scripts/uat/run-sql.mjs",
    "test:day": "tsx tests/day.test.ts",
    "test:guard": "NODE_ENV=development tsx tests/guard.test.ts && NODE_ENV=production tsx tests/guard.test.ts",
    "test": "npm run test:day && npm run test:guard && npm run test:import && npm run test:adapos && npm run test:filename && npm run test:reports && npm run test:import-units && npm run test:shift-tabs && npm run test:phone-reach && node scripts/check-permission-drift.mjs && npm run check:migration-order && npm run check:rebuilt-tables && npm run check:write-paths && npm run check:sql-write-paths && npm run check:written-and-never-read && npm run check:dark-surfaces && npm run check:types && npm run check:cascades && npm run check:nav && npm run check:loading-gates && npm run check:probe-profiles && npm run check:state && npm run check:lint",
    "check:write-paths": "node scripts/uat/check-write-paths.mjs",
    "check:rls": "node scripts/uat/check-rls.mjs",
    "types:generate": "scripts/uat/gen-types.sh",
    "check:types": "scripts/uat/gen-types.sh --check && node scripts/uat/check-type-drift.mjs",
    "test:import": "NODE_OPTIONS=--conditions=react-server tsx tests/sales-import.test.ts",
    "test:adapos": "NODE_OPTIONS=--conditions=react-server tsx tests/adapos.test.ts",
    "test:filename": "NODE_OPTIONS=--conditions=react-server tsx tests/filename.test.ts",
    "test:reports": "NODE_OPTIONS=--conditions=react-server tsx tests/report-kind.test.ts",
    "check:migration-order": "node scripts/uat/check-migration-order.mjs",
    "check:cascades": "node scripts/uat/check-cascades.mjs",
    "check:nav": "node scripts/uat/check-nav-gating.mjs",
    "test:import-units": "NODE_OPTIONS=--conditions=react-server tsx tests/product-import.test.ts",
    "exercise:feedback": "node scripts/uat/exercise-feedback.mjs",
    "exercise:deliveries": "node scripts/uat/exercise-deliveries.mjs",
    "check:state": "node scripts/uat/check-state-query.mjs",
    "check:lint": "next lint",
    "test:shift-tabs": "tsx tests/shift-tabs.test.ts",
    "check:loading-gates": "node scripts/uat/check-loading-gates.mjs",
    "check:probe-profiles": "node scripts/uat/check-probe-profiles.mjs",
    "test:phone-reach": "tsx tests/phone-reach.test.ts",
    "check:rebuilt-tables": "node scripts/uat/check-rebuilt-tables.mjs",
    "check:sql-write-paths": "node scripts/uat/check-sql-write-paths.mjs",
    "check:dark-surfaces": "node scripts/uat/check-dark-surfaces.mjs",
    "check:written-and-never-read": "node scripts/uat/check-written-and-never-read.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "pg": "^8.23.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
