# Copy this file to .env.local and fill in the values.
# Store Operations shares one Supabase project with kcp-portal so that
# employees keep a single login — use the same values as that project.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Which environment this build points at. Controls the banner across the top
# of every page (src/components/layout/EnvBanner.tsx).
#
#   production  -> no banner
#   uat         -> amber "UAT" banner
#   local       -> slate "LOCAL" banner
#
# Anything else, including leaving this unset, shows a warning banner. That is
# deliberate: only the exact string "production" hides it, so a misconfigured
# deployment shouts instead of quietly impersonating production.
#
# NEXT_PUBLIC_* values are baked in at BUILD time — changing this in the
# Vercel dashboard does nothing until you redeploy.
NEXT_PUBLIC_APP_ENV=local
